<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/recording_control_bg"
        android:padding="12dp"
        android:gravity="center">

        <!-- 准备状态布局 -->
        <LinearLayout
            android:id="@+id/layoutReady"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="准备录制"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- 按钮组：开始和取消 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="开始"
                    android:textSize="12sp"
                    android:minWidth="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnCancelReady"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="取消"
                    android:textSize="12sp"
                    android:minWidth="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:backgroundTint="#E57373" />
            </LinearLayout>
        </LinearLayout>

        <!-- 录制中状态布局 -->
        <LinearLayout
            android:id="@+id/layoutRecording"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvActionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0步"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/checkboxBatchMultiTap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="多指批量录制"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <!-- 按钮组：停止和终止 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="完成"
                    android:textSize="12sp"
                    android:minWidth="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="取消"
                    android:textSize="12sp"
                    android:minWidth="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:backgroundTint="#E57373" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/recordingHandle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="end|top"
        android:src="@drawable/recording_handle_icon"
        android:contentDescription="收起"
        app:tint="@android:color/white"
        android:padding="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp" />

    <TextView
        android:id="@+id/recordingHandleCollapsed"
        android:layout_width="24dp"
        android:layout_height="56dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/recording_control_bg"
        android:gravity="center"
        android:text="&#60;"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

</FrameLayout>
